menu "Hana charging telemetry"

config HANA_CHARGE_STATUS
    bool "Enable Hana charging-state telemetry"
    default n
    help
      Enables charging-state detection and transport for Hana peripherals.

endmenu

config ZMK_DONGLE_DISPLAY_BASE_LAYER_COUNT
    int "Number of initial layers treated as base layers"
    default 2
    range 1 8
    help
      Number of initial keymap layers treated as base layers by the shared
      dongle display. Hana/Chocofi uses two; Sofle uses one.
